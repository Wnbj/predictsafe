{
  // The Vercel Functions run on Node, not in the browser: they need Node's
  // types (process, node:crypto), which the app's own tsconfig leaves out.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
