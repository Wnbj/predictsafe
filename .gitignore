# macOS
.DS_Store

# secrets — never commit private keys / RPC secrets
.env
.env.*
*.env

# node
node_modules/

# CRE build artifacts
cre/**/.cre_build_tmp.js

# Foundry — regenerable via `forge install` / `forge build`
contracts/lib/
contracts/out/
contracts/cache/

# frontend build output
frontend/dist/

# CRE workflow config — holds the AeroDataBox API key locally.
# Copy config.staging.example.json to config.staging.json and fill it in.
cre/settlement/config.staging.json

# Everything Claude Code keeps here stays local — tooling for one machine
# rather than part of the system. `launch.json` hardcodes an absolute path to a
# bun binary in one user's home directory, so it is useless to anyone else and
# mildly leaky about who that user is; `skills/` is vendored third-party
# reference text that updates on its own schedule and would rot in this repo's
# history. `skills-lock.json` pins what is in `skills/`, so it goes with it.
.claude/
skills-lock.json

# Session notes, kept local. Working notes about a moment rather than
# documentation of the system, and they go stale between sessions in a way a
# commit history should not have to carry. What the system IS lives in
# README.md; how to operate it lives in RUNBOOK.md.
CLAUDE.md

# Compiled workflow, written by `cre workflow deploy` next to the source it
# was built from. Regenerated on every deploy and uploaded to CRE storage.
cre/**/binary.wasm.br.b64
